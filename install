#!/usr/bin/env bash
#
# HeliumCode installer
#
#   curl -fsSL https://raw.githubusercontent.com/heliumcode-labs/helium/refs/heads/main/install | bash
#
# Pin a version:
#   VERSION=0.1.2 curl -fsSL .../install | bash
#
set -euo pipefail

APP="helium"
REPO="heliumcode-labs/helium"
INSTALL_DIR="${HOME}/.helium/bin"

# pretty_dir folds $HOME to "~" so the installer's output stays inside a
# phone-sized (48-60 column) terminal instead of wrapping.
pretty_dir() {
    local d="${1:-$INSTALL_DIR}"
    if [ -n "${HOME:-}" ] && [ "${d#"$HOME"}" != "$d" ]; then
        d="~${d#"$HOME"}"
    fi
    printf '%s' "$d"
}

# ---------------------------------------------------------------- appearance
TTY_OUT=0
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ] && [ "${TERM:-dumb}" != "dumb" ]; then
    TTY_OUT=1
fi

TRUECOLOR=0
if [ "$TTY_OUT" = "1" ] && [ -z "${HELIUM_NO_TRUECOLOR:-}" ]; then
    # Modern terminals overwhelmingly support 24-bit colour; an explicit
    # HELIUM_NO_TRUECOLOR=1 opts back down to the 256-colour palette.
    TRUECOLOR=1
fi

if [ "$TTY_OUT" = "1" ]; then
    if [ "$TRUECOLOR" = "1" ]; then
        C_MINT=$'\033[38;2;79;227;193m'
        C_CORAL=$'\033[38;2;255;122;182m'
        C_GREEN=$'\033[38;2;86;211;100m'
        C_RED=$'\033[38;2;255;107;107m'
        C_YELLOW=$'\033[38;2;255;176;32m'
    else
        C_MINT=$'\033[38;5;43m'
        C_CORAL=$'\033[38;5;205m'
        C_GREEN=$'\033[38;5;40m'
        C_RED=$'\033[38;5;203m'
        C_YELLOW=$'\033[38;5;214m'
    fi
    C_DIM=$'\033[2m'
    C_BOLD=$'\033[1m'
    C_RESET=$'\033[0m'
else
    C_MINT=""; C_CORAL=""; C_GREEN=""; C_RED=""; C_YELLOW=""
    C_DIM=""; C_BOLD=""; C_RESET=""
fi

MARK_OK="${C_GREEN}${C_BOLD}✔${C_RESET}"
MARK_ERR="${C_RED}${C_BOLD}✖${C_RESET}"
MARK_STEP="${C_MINT}${C_BOLD}›${C_RESET}"

sleep_tiny() { sleep "$1" 2>/dev/null || sleep 1; }

# ------------------------------------------------------------------- drawing
term_width() {
    local w="${COLUMNS:-}"
    if [ -z "$w" ] && [ "$TTY_OUT" = "1" ] && command -v tput >/dev/null 2>&1; then
        w=$(tput cols 2>/dev/null || true)
    fi
    case "$w" in ''|*[!0-9]*) w=80 ;; esac
    # Never report a width wider than the real one: on a 40-column phone a
    # higher floor made every line wrap (and wrapped lines can't be redrawn).
    [ "$w" -lt 36 ] && w=36
    printf '%s' "$w"
}

# grad_color <percent>: mint -> violet, flat colour when truecolor is absent.
# Sets $GRAD_ESC rather than printing — draw_bar appends up to ~30 of these per
# frame, and a command substitution per cell would mean 30 forks each repaint.
GRAD_ESC=""
grad_color() {
    local p="${1:-0}" r g b
    [ "$p" -lt 0 ] && p=0
    [ "$p" -gt 100 ] && p=100
    if [ "$TRUECOLOR" = "1" ]; then
        r=$(( 79 + (139 - 79) * p / 100 ))
        g=$(( 227 + (123 - 227) * p / 100 ))
        b=$(( 193 + (247 - 193) * p / 100 ))
        printf -v GRAD_ESC '\033[38;2;%d;%d;%dm' "$r" "$g" "$b"
    else
        GRAD_ESC="$C_MINT"
    fi
}

# repeat_char <n> <char> sets $REP (fork-free).
REP=""
repeat_char() {
    local n="$1" ch="$2" out="" i
    for (( i = 0; i < n; i++ )); do out+="$ch"; done
    REP="$out"
}

# human_size_v <bytes> sets $HS; human_size prints it for one-off uses.
HS=""
human_size_v() {
    local b=${1:-0}
    b=${b//[^0-9]/}
    [ -z "$b" ] && b=0
    if [ "$b" -ge 1073741824 ]; then
        printf -v HS '%d.%d GiB' $(( b / 1073741824 )) $(( (b % 1073741824) * 10 / 1073741824 ))
    elif [ "$b" -ge 1048576 ]; then
        printf -v HS '%d.%d MiB' $(( b / 1048576 )) $(( (b % 1048576) * 10 / 1048576 ))
    elif [ "$b" -ge 1024 ]; then
        printf -v HS '%d KiB' $(( b / 1024 ))
    else
        printf -v HS '%d B' "$b"
    fi
}

human_size() {
    human_size_v "${1:-0}"
    printf '%s' "$HS"
}

human_time() {
    local s=${1:-0}
    s=${s%%.*}
    s=${s//[^0-9]/}
    [ -z "$s" ] && s=0
    if [ "$s" -lt 60 ]; then
        printf '%ds' "$s"
    else
        printf '%dm %02ds' $(( s / 60 )) $(( s % 60 ))
    fi
}

# now returns fractional seconds (end-of-download stats only); now_s is the
# fork-free integer clock used by the progress loop.
now() { date +%s.%N 2>/dev/null || date +%s; }

now_s() {
    local t=${EPOCHREALTIME:-}
    if [ -n "$t" ]; then printf '%s' "${t%%.*}"; else date +%s; fi
}

# ------------------------------------------------------------------ messages
die() {
    stop_spinner >/dev/null 2>&1 || true
    printf '  %s %s\n' "$MARK_ERR" "$1" >&2
    exit 1
}

# fit <text> [cols]: truncate to <cols> display columns, honouring SGR escape
# sequences, so a status line can never wrap (a wrapped line cannot be repainted
# and is miserable to read on a narrow phone screen).
fit() {
    local s="$1" cols="${2:-}" out="" n=0 i=0 c seq
    if [ -z "$cols" ]; then cols=$(( ${WIDTH:-80} - 4 )); fi
    [ "$cols" -lt 8 ] && cols=8

    while [ "$i" -lt "${#s}" ]; do
        c="${s:i:1}"
        if [ "$c" = $'\033' ]; then
            seq="$c"; i=$((i + 1))
            while [ "$i" -lt "${#s}" ]; do
                c="${s:i:1}"; seq+="$c"; i=$((i + 1))
                case "$c" in [a-zA-Z]) break ;; esac
            done
            out+="$seq"
            continue
        fi
        if [ "$n" -ge "$((cols - 1))" ]; then
            # Only emit a reset on a terminal; never leak escapes into pipes.
            if [ "$TTY_OUT" = "1" ]; then
                printf '%s\033[0m…' "$out"
            else
                printf '%s…' "$out"
            fi
            return 0
        fi
        out+="$c"; n=$((n + 1)); i=$((i + 1))
    done
    printf '%s' "$s"
}

ok()   { printf '  %s %s\n' "$MARK_OK" "$(fit "$1")"; }
warn() { printf '  %s %s\n' "${C_YELLOW}${C_BOLD}!${C_RESET}" "$(fit "$1")"; }

# --------------------------------------------------------------------- brand
ART_WIDTH=47
ART=(
'██╗  ██╗███████╗██╗     ██╗██╗   ██╗███╗   ███╗'
'██║  ██║██╔════╝██║     ██║██║   ██║████╗ ████║'
'███████║█████╗  ██║     ██║██║   ██║██╔████╔██║'
'██╔══██║██╔══╝  ██║     ██║██║   ██║██║╚██╔╝██║'
'██║  ██║███████╗███████╗██║╚██████╔╝██║ ╚═╝ ██║'
'╚═╝  ╚═╝╚══════╝╚══════╝╚═╝ ╚═════╝ ╚═╝     ╚═╝'
)

# Per-character gradient + a moving highlight. Falls back to a solid colour
# when the shell cannot slice the block glyphs by character or truecolor is
# unavailable. A UTF-8 ctype is what lets bash slice the glyphs by character,
# so try to switch to one before giving up (the sandbox/Termux default is often
# the bare POSIX locale, which counts bytes).
if [ "${#ART[0]}" -ne "$ART_WIDTH" ]; then
    for loc in C.UTF-8 C.utf8 en_US.UTF-8 en_US.utf8; do
        if [ "$(LC_ALL="$loc" locale charmap 2>/dev/null)" = "UTF-8" ]; then
            export LC_ALL="$loc" LC_CTYPE="$loc"
            [ "${#ART[0]}" -eq "$ART_WIDTH" ] && break
        fi
    done
fi

ART_CHARS=0
if [ "${#ART[0]}" -eq "$ART_WIDTH" ]; then ART_CHARS=1; fi

# glow_color <index> <sweep-x> sets $GLOW_ESC instead of printing, so the
# wordmark can paint ~300 cells per frame without spawning a subshell for each
# one (that alone made the splash several seconds slow).
GLOW_ESC=""
glow_color() {
    local i="$1" cx="$2" pos r g b d boost
    if [ "$TRUECOLOR" != "1" ]; then GLOW_ESC="$C_MINT"; return 0; fi
    pos=$(( i * 100 / (ART_WIDTH - 1) ))
    r=$(( 79 + (139 - 79) * pos / 100 ))
    g=$(( 227 + (123 - 227) * pos / 100 ))
    b=$(( 193 + (247 - 193) * pos / 100 ))
    d=$(( i - cx )); [ "$d" -lt 0 ] && d=$(( -d ))
    if [ "$d" -lt 8 ]; then
        boost=$(( (8 - d) * 30 / 8 ))
        r=$(( r + (255 - r) * boost / 30 ))
        g=$(( g + (255 - g) * boost / 30 ))
        b=$(( b + (255 - b) * boost / 30 ))
    fi
    printf -v GLOW_ESC '\033[38;2;%d;%d;%dm' "$r" "$g" "$b"
}

render_art() {
    local cx="$1" line i out
    for line in "${ART[@]}"; do
        if [ "$ART_CHARS" = "1" ]; then
            out=""
            for (( i = 0; i < ART_WIDTH; i++ )); do
                glow_color "$i" "$cx"
                out+="$GLOW_ESC${line:i:1}"
            done
            printf '  %s\033[0m\033[K\n' "$out"
        else
            printf '  %s%s%s\033[K\n' "$C_MINT" "$line" "$C_RESET"
        fi
    done
}

banner() {
    printf '\n'
    if [ "$TTY_OUT" = "1" ] && [ "$WIDTH" -ge $(( ART_WIDTH + 4 )) ]; then
        # Animated sweep of light across the wordmark.
        if [ "$ART_CHARS" = "1" ] && [ "$TRUECOLOR" = "1" ]; then
            local f cx
            for (( f = 0; f < 10; f++ )); do
                cx=$(( -8 + (ART_WIDTH + 16) * f / 9 ))
                [ "$f" -gt 0 ] && printf '\033[%dA' "${#ART[@]}"
                render_art "$cx"
                sleep_tiny 0.035
            done
            printf '\033[%dA' "${#ART[@]}"
            render_art -999
        else
            render_art -999
        fi
    else
        printf '  %s%s%s%s%s%s\n' "$C_BOLD" "$C_MINT" "HELIUM" "$C_RESET" "${C_CORAL}${C_BOLD}" "CODE"
    fi
}

brand_line() {
    # Plain text, so it can be measured directly: truncate the tagline instead
    # of letting it wrap on a narrow screen.
    local tag="· the noble gas that lifts your terminal"
    local max=$(( ${WIDTH:-80} - 7 ))
    [ "$max" -lt 4 ] && max=4
    if [ "${#tag}" -gt "$max" ]; then
        tag="${tag:0:$((max - 1))}…"
    fi
    printf '  %s%s%s%s %s%s%s\n' \
        "$C_BOLD" "$C_CORAL" "code" "$C_RESET" "$C_DIM" "$tag" "$C_RESET"
}

# ------------------------------------------------------------------- spinner
SPINNER_PID=""
TMP_DIR=""

cleanup() {
    stop_spinner >/dev/null 2>&1 || true
    [ -n "${checksum_pid:-}" ] && kill "$checksum_pid" 2>/dev/null || true
    [ -n "$TMP_DIR" ] && rm -rf "$TMP_DIR" 2>/dev/null || true
}
trap cleanup EXIT

start_spinner() {
    [ "$TTY_OUT" = "1" ] || return 0
    local msg="$1"
    local -a frames=(⠋ ⠙ ⠹ ⠸ ⠼ ⠴ ⠦ ⠧ ⠇ ⠏)
    (
        i=0
        while :; do
            printf '\r  %s%s%s %s\033[K' "$C_MINT" "${frames[$(( i % 10 ))]}" "$C_RESET" "$msg"
            i=$(( i + 1 ))
            sleep_tiny 0.08
        done
    ) &
    SPINNER_PID=$!
}

stop_spinner() {
    if [ -n "$SPINNER_PID" ]; then
        kill "$SPINNER_PID" 2>/dev/null || true
        wait "$SPINNER_PID" 2>/dev/null || true
        SPINNER_PID=""
    fi
    [ "$TTY_OUT" = "1" ] && printf '\r\033[2K'
    return 0
}

# ------------------------------------------------------------------ download
# draw_bar <prefix> <cur> <total> <term_width> <stats>: single line, no newline.
# Size and speed/ETA are printed only when they fit: a wrapped line cannot be
# repainted with \r, which garbles the animation on a phone-sized screen.
draw_bar() {
    local prefix="$1" cur="$2" total="$3" avail="${4:-80}" stats="${5:-}"
    local pct=0
    if [ "$total" -gt 0 ]; then
        pct=$(( cur * 100 / total ))
        [ "$pct" -gt 100 ] && pct=100
    fi

    # Keep the label short enough that "  label [bar] 100%" plus a minimum bar
    # still fits the terminal (indent 2 + brackets 4 + percent 4 + bar 8).
    local max_prefix=$(( avail - 18 ))
    [ "$max_prefix" -lt 8 ] && max_prefix=8
    if [ "${#prefix}" -gt "$max_prefix" ]; then
        # Prefer dropping the verb over slicing the version number in half.
        local short="${prefix#Downloading }"
        if [ "$short" != "$prefix" ] && [ "${#short}" -le "$max_prefix" ]; then
            prefix="$short"
        else
            prefix="${prefix:0:$max_prefix}"
        fi
    fi

    human_size_v "$cur"
    local size="$HS"

    local fixed=$(( 2 + ${#prefix} + 4 + 4 ))
    local bw want_size=0 want_stats=0

    if [ -n "$stats" ] && [ $(( avail - fixed - ${#stats} - 2 - ${#size} - 2 )) -ge 10 ]; then
        want_stats=1 want_size=1
    elif [ $(( avail - fixed - ${#size} - 2 )) -ge 10 ]; then
        want_size=1
    fi
    bw=$(( avail - fixed - want_size * (${#size} + 2) - want_stats * (${#stats} + 2) ))
    [ "$bw" -lt 8 ] && bw=8
    [ "$bw" -gt 30 ] && bw=30

    local eighths=$(( pct * bw * 8 / 100 ))
    local full=$(( eighths / 8 ))
    local rem=$(( eighths % 8 ))
    local -a partial=(▏ ▎ ▍ ▌ ▋ ▊ ▉)
    local d=$(( bw > 1 ? bw - 1 : 1 ))

    local bar="" i
    for (( i = 0; i < full; i++ )); do
        grad_color $(( i * 100 / d ))
        bar+="$GRAD_ESC█"
    done
    if [ "$rem" -gt 0 ]; then
        grad_color $(( full * 100 / d ))
        bar+="$GRAD_ESC${partial[$(( rem - 1 ))]}"
    fi

    local used=$(( full + (rem > 0 ? 1 : 0) ))
    local pad=$(( bw - used ))
    local tail=""
    if [ "$pad" -gt 0 ]; then
        repeat_char "$pad" ░
        tail="$REP"
    fi

    printf '\r  %s%s%s [%s%s%s%s] %s%3d%%%s' \
        "$C_DIM" "$prefix" "$C_RESET" \
        "$C_DIM" "$bar" "$tail" "$C_RESET" \
        "$C_BOLD" "$pct" "$C_RESET"
    [ "$want_size" = 1 ] && printf '  %s' "$size"
    [ "$want_stats" = 1 ] && printf '  %s%s%s' "$C_DIM" "$stats" "$C_RESET"
    printf '\033[K'
}

# download <url> <out> <label>
download() {
    local url="$1" out="$2" label="$3"

    if [ "$TTY_OUT" != "1" ]; then
        printf '  %s Downloading %s\n' "$C_MINT" "$label"
        curl -fL --retry 3 --connect-timeout 20 -o "$out" "$url" >/dev/null 2>&1 \
            || return 1
        return 0
    fi

    local start start_int cur=0 total=0 elapsed rc=0 stats speed sp secs
    local prefix="Downloading ${label}"
    local size_file="$out.size"
    start=$(now)
    start_int=${start%%.*}

    # Launch the size probe together with the payload so its HEAD round trip
    # never sits in front of the first byte (a whole extra RTT on mobile).
    {
        curl -sIL --max-time 20 "$url" 2>/dev/null \
            | tr -d '\r' \
            | awk 'tolower($1) == "content-length:" { len = $2 } END { print len + 0 }' \
            > "$size_file"
    } &
    local size_pid=$!

    curl -fL --retry 3 --connect-timeout 20 -o "$out" "$url" 2>/dev/null &
    local curl_pid=$!

    while kill -0 "$curl_pid" 2>/dev/null; do
        if [ -f "$out" ]; then
            cur=$(wc -c < "$out" 2>/dev/null || echo 0)
            cur=${cur//[^0-9]/}
            [ -z "$cur" ] && cur=0

            if [ -s "$size_file" ]; then
                total=$(cat "$size_file" 2>/dev/null || echo 0)
                total=${total//[^0-9]/}
                [ -z "$total" ] && total=0
                rm -f "$size_file"
            fi

            # Speed / ETA in plain arithmetic: no awk, no subshells per frame.
            stats=""
            elapsed=$(( $(now_s) - start_int ))
            if [ "$elapsed" -ge 1 ] && [ "$cur" -gt 0 ]; then
                sp=$(( cur / elapsed ))
                if [ "$sp" -ge 1048576 ]; then
                    printf -v stats '%d.%d MiB/s' $(( sp / 1048576 )) $(( (sp % 1048576) * 10 / 1048576 ))
                elif [ "$sp" -ge 1024 ]; then
                    printf -v stats '%d KiB/s' $(( sp / 1024 ))
                else
                    printf -v stats '%d B/s' "$sp"
                fi
                if [ "$total" -gt 0 ] && [ "$sp" -gt 0 ] && [ "$cur" -lt "$total" ]; then
                    secs=$(( (total - cur) / sp ))
                    if [ "$secs" -lt 60 ]; then
                        stats="$stats  ·  ETA ${secs}s"
                    else
                        stats="$stats  ·  ETA $(( secs / 60 ))m $(( secs % 60 ))s"
                    fi
                fi
            fi

            draw_bar "$prefix" "$cur" "$total" "$WIDTH" "$stats"
        fi
        sleep_tiny 0.1
    done

    wait "$curl_pid" || rc=$?
    wait "$size_pid" 2>/dev/null || true
    rm -f "$size_file"
    if [ "$rc" -ne 0 ]; then
        printf '\r\033[K'
        return 1
    fi

    cur=$(wc -c < "$out" 2>/dev/null || echo 0)
    cur=${cur//[^0-9]/}
    [ -z "$cur" ] && cur=0
    elapsed=$(awk -v a="$start_int" -v b="$(now)" 'BEGIN { printf "%d", b - a + 0.5 }')

    speed=""
    if [ "${elapsed:-0}" -gt 0 ] && [ "$cur" -gt 0 ]; then
        sp=$(( cur / elapsed ))
        if [ "$sp" -ge 1048576 ]; then
            printf -v speed '%d.%d MiB/s' $(( sp / 1048576 )) $(( (sp % 1048576) * 10 / 1048576 ))
        elif [ "$sp" -ge 1024 ]; then
            printf -v speed '%d KiB/s' $(( sp / 1024 ))
        else
            printf -v speed '%d B/s' "$sp"
        fi
    fi

    human_size_v "$cur"
    local final="Downloaded $HS in $(human_time "$elapsed")"
    if [ -n "$speed" ] && [ $(( 4 + ${#final} + 3 + ${#speed} )) -le "${WIDTH:-80}" ]; then
        final="$final · $speed"
    fi
    printf '\r\033[K  %s %s\n' "$MARK_OK" "$final"
    return 0
}

# --------------------------------------------------------------------- usage
usage() {
    cat <<EOF
${C_BOLD}HeliumCode installer${C_RESET}

Usage: install [options]

Options:
  -v, --version <x.y.z>  Install a specific version (or set VERSION=x.y.z)
  -h, --help             Show this help

Installs to: ${INSTALL_DIR}
EOF
}

# ---------------------------------------------------------------------- args
requested_version="${VERSION:-}"
while [ "$#" -gt 0 ]; do
    case "${1:-}" in
        -v|--version)
            [ "$#" -ge 2 ] || die "--version needs a value, e.g. --version 0.1.2"
            requested_version="$2"
            shift 2
            ;;
        -h|--help) usage; exit 0 ;;
        *)         shift ;;
    esac
done

# ---------------------------------------------------------- platform detect
os=$(uname -s | tr '[:upper:]' '[:lower:]')
[ "$os" = "darwin" ] && os="mac"

arch=$(uname -m)
case "$arch" in
    aarch64) arch="arm64" ;;
    x64)     arch="x86_64" ;;
esac

filename="$APP-$os-$arch.tar.gz"

case "$filename" in
    *-linux-*)
        case "$arch" in x86_64|arm64|i386) : ;; *) die "Unsupported architecture: $os/$arch" ;; esac ;;
    *-mac-*)
        case "$arch" in x86_64|arm64) : ;; *) die "Unsupported architecture: $os/$arch" ;; esac ;;
    *)
        die "Unsupported OS/architecture: $os/$arch (linux and mac are supported)" ;;
esac

WIDTH=$(term_width)

# -------------------------------------------------------------------- brand
banner
brand_line
printf '\n'

# --------------------------------------------------------------- resolve tag
if [ -z "$requested_version" ]; then
    start_spinner "Resolving latest release…"
    specific_version=$(curl -fsSL --max-time 20 \
        "https://api.github.com/repos/${REPO}/releases/latest" 2>/dev/null \
        | awk -F'"' '/"tag_name": "/ { gsub(/^v/, "", $4); print $4; exit }') || specific_version=""
    stop_spinner
    [ -n "$specific_version" ] || die "Could not find a published release for ${REPO}."
    url="https://github.com/${REPO}/releases/latest/download/${filename}"
else
    specific_version=$(printf '%s' "$requested_version" | sed 's/^v//')
    url="https://github.com/${REPO}/releases/download/v${specific_version}/${filename}"
fi

ok "Latest release ${C_BOLD}v${specific_version}${C_RESET} ${C_DIM}· ${os}/${arch}${C_RESET}"

# Already installed?
mkdir -p "$INSTALL_DIR"
if [ -x "$INSTALL_DIR/$APP" ]; then
    installed_version=$("$INSTALL_DIR/$APP" -v 2>/dev/null | head -1 | sed 's/^v//' || true)
    if [ -n "$installed_version" ] && [ "$installed_version" = "$specific_version" ]; then
        ok "HeliumCode ${C_BOLD}v${specific_version}${C_RESET} is already installed ${C_DIM}($INSTALL_DIR)${C_RESET}"
        printf '\n'
        exit 0
    fi
fi

TMP_DIR=$(mktemp -d 2>/dev/null || mktemp -d -t helium)
archive="$TMP_DIR/$filename"

# -------------------------------------------------- checksums (concurrent)
# Pull the checksums alongside the archive instead of before it, so
# verification never adds a round trip to the install.
{ curl -fsSL --max-time 20 -o "$TMP_DIR/checksums.txt" \
    "https://github.com/${REPO}/releases/download/v${specific_version}/checksums.txt" \
    2>/dev/null || rm -f "$TMP_DIR/checksums.txt"; } &
checksum_pid=$!

# ----------------------------------------------------------------- download
download "$url" "$archive" "${APP} v${specific_version}" || die "Download failed: $url"

wait "$checksum_pid" 2>/dev/null || true

# ----------------------------------------------------------------- checksum
if [ -f "$TMP_DIR/checksums.txt" ]; then
    if command -v sha256sum >/dev/null 2>&1 || command -v shasum >/dev/null 2>&1; then
        expected=$(awk -v f="$filename" '$2 == f { print $1; exit }' "$TMP_DIR/checksums.txt")
        if [ -n "$expected" ]; then
            if command -v sha256sum >/dev/null 2>&1; then
                actual=$(sha256sum "$archive" | awk '{ print $1 }')
            else
                actual=$(shasum -a 256 "$archive" | awk '{ print $1 }')
            fi
            if [ "$actual" = "$expected" ]; then
                ok "Checksum verified ${C_DIM}(sha256)${C_RESET}"
            else
                die "Checksum mismatch — refusing to install (expected $expected, got $actual)"
            fi
        fi
    fi
else
    warn "No checksums published for v${specific_version}; skipping verification"
fi

# ------------------------------------------------------------------- extract
start_spinner "Unpacking…"
tar -xzf "$archive" -C "$TMP_DIR" 2>/dev/null || { stop_spinner; die "Could not extract $filename"; }
stop_spinner
[ -f "$TMP_DIR/$APP" ] || die "Archive did not contain the $APP binary"
chmod +x "$TMP_DIR/$APP"

start_spinner "Installing…"
mv "$TMP_DIR/$APP" "$INSTALL_DIR/$APP"
stop_spinner
ok "Installed to ${C_DIM}$(pretty_dir "$INSTALL_DIR")/${APP}${C_RESET}"

# --------------------------------------------------------------------- PATH
XDG_CONFIG_HOME=${XDG_CONFIG_HOME:-$HOME/.config}
current_shell=$(basename "${SHELL:-/bin/bash}")

case $current_shell in
    fish) config_files="$HOME/.config/fish/config.fish" ;;
    zsh)  config_files="$HOME/.zshrc $HOME/.zshenv $XDG_CONFIG_HOME/zsh/.zshrc $XDG_CONFIG_HOME/zsh/.zshenv" ;;
    sh|ash|dash) config_files="$HOME/.ashrc $HOME/.profile /etc/profile" ;;
    *)    config_files="$HOME/.bashrc $HOME/.bash_profile $HOME/.profile $XDG_CONFIG_HOME/bash/.bashrc $XDG_CONFIG_HOME/bash/.bash_profile" ;;
esac

config_file=""
for file in $config_files; do
    if [[ -f $file ]]; then
        config_file=$file
        break
    fi
done

path_line() {
    # Absolute path: this is what lands in the shell profile, where a leading
    # "~" is not guaranteed to expand in every shell.
    case $current_shell in
        fish) printf 'fish_add_path %s' "$INSTALL_DIR" ;;
        *)    printf 'export PATH=%s:$PATH' "$INSTALL_DIR" ;;
    esac
}

# path_line_display is what we show the user to copy: the "~" form, which the
# shell expands and which fits a narrow terminal.
path_line_display() {
    case $current_shell in
        fish) printf 'fish_add_path %s' "$(pretty_dir "$INSTALL_DIR")" ;;
        *)    printf 'export PATH=%s:$PATH' "$(pretty_dir "$INSTALL_DIR")" ;;
    esac
}

PATH_FILE=""
PATH_MANUAL=0
PATH_LIVE=0
if [[ ":$PATH:" == *":$INSTALL_DIR:"* ]]; then
    PATH_LIVE=1
    ok "Already on ${C_BOLD}PATH${C_RESET}"
elif [[ -n $config_file ]] && grep -qF "$INSTALL_DIR" "$config_file" 2>/dev/null; then
    # Already configured, just not loaded into the current shell yet.
    PATH_FILE="$config_file"
elif [[ -n $config_file && -w $config_file ]]; then
    {
        printf '\n# helium\n'
        path_line
        printf '\n'
    } >> "$config_file"
    PATH_FILE="$config_file"
    ok "Updated ${C_BOLD}PATH${C_RESET} in ${C_DIM}$config_file${C_RESET}"
else
    PATH_MANUAL=1
fi

if [ -n "${GITHUB_ACTIONS:-}" ] && [ "${GITHUB_ACTIONS}" = "true" ]; then
    echo "$INSTALL_DIR" >> "$GITHUB_PATH"
fi

# --------------------------------------------------------------------- done
printf '\n'
printf '  %s%s%s %s%s%s  %s%s%s\n' \
    "$C_GREEN" "✔" "$C_RESET" \
    "$C_BOLD" "HeliumCode" "$C_RESET" \
    "$C_BOLD" "v${specific_version}${C_RESET} ${C_MINT}is ready${C_RESET}" ""
printf '\n'
# Lead with a command that works right now: a PATH entry written to a config
# file isn't live in this shell until it's reloaded, so spell out the sequence.
if [ "$PATH_LIVE" = "1" ]; then
    printf '  %s→%s %s%s%s          %sstart here%s\n' "$C_MINT" "$C_RESET" \
        "$C_BOLD" "helium" "$C_RESET" "$C_DIM" "$C_RESET"
    printf '  %s→%s %s%s%s   %swhat it does%s\n' "$C_MINT" "$C_RESET" \
        "$C_BOLD" "helium --help" "$C_RESET" "$C_DIM" "$C_RESET"
elif [ "$PATH_MANUAL" = "1" ]; then
    printf '  %sfirst%s  add helium to PATH:\n' "$C_MINT" "$C_RESET"
    printf '    %s%s%s\n' "$C_MINT" "$(path_line_display)" "$C_RESET"
    printf '  %sthen%s   %s%s%s\n' "$C_MINT" "$C_RESET" "$C_BOLD" "helium" "$C_RESET"
else
    printf '  %sfirst%s  %s%s%s\n' "$C_MINT" "$C_RESET" "$C_MINT" \
        "source $(pretty_dir "$PATH_FILE")" "$C_RESET"
    printf '  %sthen%s   %s%s%s\n' "$C_MINT" "$C_RESET" "$C_BOLD" "helium" "$C_RESET"
fi
printf '\n'