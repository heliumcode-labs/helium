#!/usr/bin/env bash
#
# HeliumCode installer
#
#   curl -fsSL https://raw.githubusercontent.com/OWNER/REPO/refs/heads/main/install | bash
#
# Pin a version with:  VERSION=0.1.0 curl ... | bash
#
set -euo pipefail

APP="helium"
REPO="heliumcode-labs/helium"
INSTALL_DIR="${HOME}/.helium/bin"

# ---------------------------------------------------------------- appearance
TTY_OUT=0
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ] && [ "${TERM:-dumb}" != "dumb" ]; then
    TTY_OUT=1
fi

if [ "$TTY_OUT" = "1" ]; then
    if [ "${COLORTERM:-}" = "truecolor" ] || [ "${COLORTERM:-}" = "24bit" ]; then
        C_MINT=$'\033[38;2;79;227;193m'
        C_VIOLET=$'\033[38;2;139;123;247m'
        C_CORAL=$'\033[38;2;255;122;182m'
        C_GREEN=$'\033[38;2;86;211;100m'
        C_RED=$'\033[38;2;255;107;107m'
        C_YELLOW=$'\033[38;2;255;176;32m'
    else
        C_MINT=$'\033[38;5;43m'
        C_VIOLET=$'\033[38;5;99m'
        C_CORAL=$'\033[38;5;205m'
        C_GREEN=$'\033[38;5;40m'
        C_RED=$'\033[38;5;203m'
        C_YELLOW=$'\033[38;5;214m'
    fi
    C_BOLD=$'\033[1m'
    C_DIM=$'\033[2m'
    C_RESET=$'\033[0m'
else
    C_MINT=""; C_VIOLET=""; C_CORAL=""; C_GREEN=""; C_RED=""; C_YELLOW=""
    C_BOLD=""; C_DIM=""; C_RESET=""
fi

MARK_OK="${C_GREEN}${C_BOLD}✔${C_RESET}"
MARK_WARN="${C_YELLOW}${C_BOLD}!${C_RESET}"
MARK_ERR="${C_RED}${C_BOLD}✖${C_RESET}"
MARK_INFO="${C_MINT}${C_BOLD}›${C_RESET}"

sleep_tiny() { sleep "$1" 2>/dev/null || sleep 1; }

# ------------------------------------------------------------------ helpers
SPINNER_PID=""
TMP_DIR=""

cleanup() {
    stop_spinner >/dev/null 2>&1 || true
    [ -n "$TMP_DIR" ] && rm -rf "$TMP_DIR" 2>/dev/null || true
}
trap cleanup EXIT

die() {
    printf '  %s %s\n' "$MARK_ERR" "$1" >&2
    exit 1
}

ok()   { printf '  %s %s\n' "$MARK_OK" "$1"; }
info() { printf '  %s %s\n' "$MARK_INFO" "$1"; }
warn() { printf '  %s %s\n' "$MARK_WARN" "$1"; }

section() {
    printf '\n%s%s%s\n' "$C_BOLD" "$1" "$C_RESET"
}

# Staggered line printing: each line fades in a moment after the previous one.
anim_line() {
    printf '%s\n' "$1"
    [ "$TTY_OUT" = "1" ] && sleep_tiny "${2:-0.12}"
    return 0
}

start_spinner() {
    [ "$TTY_OUT" = "1" ] || return 0
    local msg="$1"
    local -a frames=(⠋ ⠙ ⠹ ⠸ ⠼ ⠴ ⠦ ⠧ ⠇ ⠏)
    (
        i=0
        while :; do
            frame=${frames[$(( i % 10 ))]}
            printf '\r  %s%s%s %s\033[K' "$C_MINT" "$frame" "$C_RESET" "$msg"
            i=$(( i + 1 ))
            sleep_tiny 0.09
        done
    ) &
    SPINNER_PID=$!
}

stop_spinner() {
    if [ -n "$SPINNER_PID" ]; then
        kill "$SPINNER_PID" 2>/dev/null || true
        wait "$SPINNER_PID" 2>/dev/null || true
        SPINNER_PID=""
    fi
    [ "$TTY_OUT" = "1" ] && printf '\r\033[2K'
    return 0
}

human_size() {
    awk -v b="${1:-0}" 'BEGIN {
        if (b >= 1073741824)      printf "%.1f GiB", b / 1073741824
        else if (b >= 1048576)    printf "%.1f MiB", b / 1048576
        else if (b >= 1024)       printf "%.1f KiB", b / 1024
        else                      printf "%d B", b
    }'
}

# Animated download: curl runs in the background while a progress bar is
# painted from the growing file size. Falls back to plain output when the
# script is not attached to a terminal.
download_with_progress() {
    local url="$1" out="$2" label="$3"
    local total=0 cur=0 pct=0 rc=0

    total=$(curl -sIL --max-time 20 "$url" 2>/dev/null | tr -d '\r' \
        | awk 'tolower($1) == "content-length:" { len = $2 } END { print len + 0 }') || total=0
    total=${total:-0}

    if [ "$TTY_OUT" != "1" ]; then
        info "$label"
        curl -fL --retry 3 --connect-timeout 15 -o "$out" "$url" >/dev/null 2>&1 || return 1
        return 0
    fi

    start_spinner "$label"
    curl -fL --retry 3 --connect-timeout 15 -o "$out" "$url" 2>/dev/null &
    local curl_pid=$!

    while kill -0 "$curl_pid" 2>/dev/null; do
        if [ -f "$out" ]; then
            cur=$(wc -c < "$out" 2>/dev/null | tr -d ' ' || echo 0)
            cur=${cur:-0}
            if [ "$total" -gt 0 ]; then
                pct=$(( cur * 100 / total ))
                [ "$pct" -gt 100 ] && pct=100
                local width=32 filled i bar="" pad=""
                filled=$(( pct * width / 100 ))
                for (( i = 0; i < filled; i++ )); do bar="${bar}█"; done
                for (( i = filled; i < width; i++ )); do pad="${pad}─"; done
                printf '\r  %s[%s%s%s%s]%s %3d%%  %s%s\033[K' \
                    "$C_MINT" "$C_BOLD" "$bar" "$C_DIM" "$pad" "$C_RESET" \
                    "$pct" "$(human_size "$cur")" "$C_DIM"
            else
                printf '\r  %s%s%s  %s\033[K' "$C_MINT" "$C_BOLD" "$label" \
                    "$(human_size "$cur")$C_RESET"
            fi
        fi
        sleep_tiny 0.1
    done

    wait "$curl_pid" || rc=$?
    stop_spinner
    [ "$rc" -eq 0 ] || return 1

    if [ "$total" -gt 0 ] && [ -f "$out" ]; then
        printf '  %s[%s%s%s%s]%s %3d%%  %s\n' \
            "$C_MINT" "$C_BOLD" "$(printf '█%.0s' $(seq 1 32))" "$C_DIM" "" "$C_RESET" \
            100 "$(human_size "$(wc -c < "$out" | tr -d ' ')")"
    fi
    return 0
}

usage() {
    cat <<EOF
${C_BOLD}HeliumCode installer${C_RESET}

Usage: install [options]

Options:
  -v, --version <x.y.z>  Install a specific version (or set VERSION=x.y.z)
  -h, --help             Show this help

Install dir: ${INSTALL_DIR}
EOF
}

# -------------------------------------------------------------------- args
requested_version="${VERSION:-}"
while [ $# -gt 0 ]; do
    case "$1" in
        -v|--version) requested_version="${2:-}"; shift 2 ;;
        -h|--help)    usage; exit 0 ;;
        *)            shift ;;
    esac
done

# ------------------------------------------------------------ platform check
os=$(uname -s | tr '[:upper:]' '[:lower:]')
[ "$os" = "darwin" ] && os="mac"

arch=$(uname -m)
[ "$arch" = "aarch64" ] && arch="arm64"
[ "$arch" = "x64" ] && arch="x86_64"

filename="$APP-$os-$arch.tar.gz"

case "$filename" in
    *-linux-*)
        case "$arch" in x86_64|arm64|i386) : ;; *) die "Unsupported architecture: $os/$arch" ;; esac ;;
    *-mac-*)
        case "$arch" in x86_64|arm64) : ;; *) die "Unsupported architecture: $os/$arch" ;; esac ;;
    *)
        die "Unsupported OS/architecture: $os/$arch (linux and mac are supported)" ;;
esac

# ------------------------------------------------------------------- banner
INNER=38
if [ "$TTY_OUT" = "1" ]; then
    TL="╭"; TR="╮"; BL="╰"; BR="╯"; VB="│"; HS="─"
else
    TL="+"; TR="+"; BL="+"; BR="+"; VB="|"; HS="-"
fi
HSEP=$(printf '%*s' "$INNER" ''); HSEP=${HSEP// /"$HS"}

printf '\n'
anim_line "  ${C_MINT}${TL}${HSEP}${TR}${C_RESET}"

plain1=$(printf '%-*s' "$INNER" "  He  HeliumCode")
plain1=${plain1/He/"${C_BOLD}${C_MINT}He${C_RESET}${C_BOLD}"}
plain1=${plain1/HeliumCode/"${C_BOLD}Helium${C_RESET}${C_CORAL}${C_BOLD}Code${C_RESET}${C_DIM}"}
anim_line "  ${C_MINT}${VB}${C_RESET}${plain1}${C_RESET}${C_MINT}${VB}${C_RESET}"

plain2=$(printf '%-*s' "$INNER" "      the noble gas that lifts your code")
anim_line "  ${C_MINT}${VB}${C_RESET}${C_DIM}${plain2}${C_RESET}${C_MINT}${VB}${C_RESET}"

anim_line "  ${C_MINT}${BL}${HSEP}${BR}${C_RESET}"
printf '\n'

# --------------------------------------------------------------- resolve tag
if [ -z "$requested_version" ]; then
    start_spinner "Resolving latest release…"
    specific_version=$(curl -fsSL --max-time 20 \
        "https://api.github.com/repos/${REPO}/releases/latest" 2>/dev/null \
        | awk -F'"' '/"tag_name": "/ { gsub(/^v/, "", $4); print $4; exit }') || specific_version=""
    stop_spinner
    [ -n "$specific_version" ] || die "Could not reach the release feed for ${REPO}. Is the version published yet?"
    url="https://github.com/${REPO}/releases/latest/download/${filename}"
else
    specific_version=$(printf '%s' "$requested_version" | sed 's/^v//')
    url="https://github.com/${REPO}/releases/download/v${specific_version}/${filename}"
fi

section "Install  ${C_DIM}v${specific_version} · ${os}/${arch}${C_RESET}"

# Already installed?
mkdir -p "$INSTALL_DIR"
if [ -x "$INSTALL_DIR/$APP" ]; then
    installed_version=$("$INSTALL_DIR/$APP" -v 2>/dev/null | head -1 | sed 's/^v//' || true)
    if [ -n "$installed_version" ] && [ "$installed_version" = "$specific_version" ]; then
        ok "HeliumCode ${C_BOLD}v${specific_version}${C_RESET} is already installed at ${C_DIM}$INSTALL_DIR${C_RESET}"
        exit 0
    fi
fi

TMP_DIR=$(mktemp -d 2>/dev/null || mktemp -d -t helium)
archive="$TMP_DIR/$filename"

# ------------------------------------------------------------------ download
start_spinner "Preparing download…"
curl -fsSL --max-time 20 -o "$TMP_DIR/checksums.txt" \
    "https://github.com/${REPO}/releases/download/v${specific_version}/checksums.txt" \
    2>/dev/null || rm -f "$TMP_DIR/checksums.txt"
stop_spinner

if ! download_with_progress "$url" "$archive" "Downloading ${APP} v${specific_version}"; then
    die "Download failed: $url"
fi

# ---------------------------------------------------------------- checksum
if [ -f "$TMP_DIR/checksums.txt" ]; then
    if command -v sha256sum >/dev/null 2>&1 || command -v shasum >/dev/null 2>&1; then
        expected=$(awk -v f="$filename" '$2 == f { print $1; exit }' "$TMP_DIR/checksums.txt")
        if [ -n "$expected" ]; then
            if command -v sha256sum >/dev/null 2>&1; then
                actual=$(sha256sum "$archive" | awk '{ print $1 }')
            else
                actual=$(shasum -a 256 "$archive" | awk '{ print $1 }')
            fi
            if [ "$actual" = "$expected" ]; then
                ok "Checksum verified"
            else
                die "Checksum mismatch — refusing to install (expected $expected, got $actual)"
            fi
        fi
    fi
else
    warn "Checksums not available for v${specific_version}; skipping verification"
fi

# ------------------------------------------------------------------ extract
start_spinner "Unpacking…"
tar -xzf "$archive" -C "$TMP_DIR" || { stop_spinner; die "Could not extract $filename"; }
stop_spinner
[ -f "$TMP_DIR/$APP" ] || die "Archive did not contain the $APP binary"
chmod +x "$TMP_DIR/$APP"

start_spinner "Installing to ${INSTALL_DIR}…"
mv "$TMP_DIR/$APP" "$INSTALL_DIR/$APP"
stop_spinner
ok "Installed ${C_BOLD}${APP}${C_RESET} → ${C_DIM}${INSTALL_DIR}/${APP}${C_RESET}"

# --------------------------------------------------------------------- PATH
XDG_CONFIG_HOME=${XDG_CONFIG_HOME:-$HOME/.config}
current_shell=$(basename "${SHELL:-/bin/bash}")

case $current_shell in
    fish) config_files="$HOME/.config/fish/config.fish" ;;
    zsh)  config_files="$HOME/.zshrc $HOME/.zshenv $XDG_CONFIG_HOME/zsh/.zshrc $XDG_CONFIG_HOME/zsh/.zshenv" ;;
    ash)  config_files="$HOME/.ashrc $HOME/.profile /etc/profile" ;;
    sh)   config_files="$HOME/.ashrc $HOME/.profile /etc/profile" ;;
    *)    config_files="$HOME/.bashrc $HOME/.bash_profile $HOME/.profile $XDG_CONFIG_HOME/bash/.bashrc $XDG_CONFIG_HOME/bash/.bash_profile" ;;
esac

config_file=""
for file in $config_files; do
    if [[ -f $file ]]; then
        config_file=$file
        break
    fi
done

path_line() {
    case $current_shell in
        fish) printf 'fish_add_path %s' "$INSTALL_DIR" ;;
        *)    printf 'export PATH=%s:$PATH' "$INSTALL_DIR" ;;
    esac
}

if [[ ":$PATH:" != *":$INSTALL_DIR:"* ]]; then
    if [[ -n $config_file && -w $config_file ]] && ! grep -qF "$INSTALL_DIR" "$config_file"; then
        {
            printf '\n# helium\n'
            path_line
            printf '\n'
        } >> "$config_file"
        ok "Added to ${C_BOLD}PATH${C_RESET} in ${C_DIM}$config_file${C_RESET}"
    else
        warn "Add this line to your shell profile:"
        printf '     %s%s%s\n' "$C_MINT" "$(path_line)" "$C_RESET"
    fi
else
    ok "Already on ${C_BOLD}PATH${C_RESET}"
fi

if [ -n "${GITHUB_ACTIONS:-}" ] && [ "${GITHUB_ACTIONS}" = "true" ]; then
    echo "$INSTALL_DIR" >> "$GITHUB_PATH"
    ok "Added ${INSTALL_DIR} to \$GITHUB_PATH"
fi

# --------------------------------------------------------------------- done
printf '\n%s%s%s\n' "$C_BOLD" "  Ready." "$C_RESET"
printf '   %s%s%s%s --help%s   show what it can do\n' "$C_MINT" "$C_BOLD" "$APP" "$C_RESET" "$C_DIM"
printf '   %s%s%s%s%s          start the assistant\n\n' "$C_MINT" "$C_BOLD" "$APP" "$C_RESET" "$C_DIM"
if [[ ":$PATH:" != *":$INSTALL_DIR:"* ]]; then
    printf '   %sStart a new shell (or run: %s) to pick up helium.%s\n\n' "$C_DIM" "$(path_line)" "$C_RESET"
fi
